# Copy this file to android/keystore.properties and fill values with your keystore details
# Keep the real keystore file and keystore.properties out of version control.
# Example:
# storeFile=/home/you/.android/release.keystore
# storePassword=your_store_password
# keyAlias=your_key_alias
# keyPassword=your_key_password

storeFile=../release-keystore.jks
storePassword=your_store_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here
